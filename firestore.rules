rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'njrcell.official@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Pillar 2: Validation Blueprint for Slide
    function isValidSlide(data) {
      return data.keys().hasAll([
        'title',
        'subtitle',
        'category',
        'buttonText',
        'targetUrl',
        'imageUrl',
        'storagePath',
        'alt',
        'order',
        'status',
        'startAt',
        'endAt',
        'authorUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'subtitle',
        'category',
        'buttonText',
        'targetUrl',
        'imageUrl',
        'storagePath',
        'alt',
        'order',
        'status',
        'startAt',
        'endAt',
        'authorUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 300 &&
      data.category is string && data.category in ['Keuangan', 'Digital', 'Aksesori', 'Info'] &&
      data.buttonText is string && data.buttonText.size() >= 1 && data.buttonText.size() <= 60 &&
      data.targetUrl is string && data.targetUrl.size() >= 1 && data.targetUrl.size() <= 500 && data.targetUrl.matches('^https?://.+') &&
      data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000 &&
      data.storagePath is string && data.storagePath.size() <= 300 &&
      data.alt is string && data.alt.size() >= 1 && data.alt.size() <= 160 &&
      data.order is number && data.order >= 1 && data.order <= 999 &&
      data.status is string && data.status in ['Draft', 'Scheduled', 'Published', 'Expired', 'Archived'] &&
      data.startAt is string && data.startAt.size() <= 40 &&
      data.endAt is string && data.endAt.size() <= 40 &&
      data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint for AdminProfile
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'role', 'addedByUid', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'role', 'addedByUid', 'createdAt']) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.role is string && data.role == 'admin' &&
      data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 && data.addedByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.addedByUid == request.auth.uid &&
      data.createdAt is timestamp;
    }

    // Collection: /slides/{slideId}
    match /slides/{slideId} {
      allow get: if isValidId(slideId) && (
        existing().status == 'Published' || isAdmin()
      );

      // Pillar 8: Secure List Queries without get()/exists() cost explosion
      allow list: if existing().status == 'Published' || (
        isVerifiedUser() && (
          request.auth.token.email == 'njrcell.official@gmail.com' ||
          existing().authorUid == request.auth.uid
        )
      );

      allow create: if isSignedIn() &&
        isValidId(slideId) &&
        isValidSlide(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(slideId) &&
        isValidSlide(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().authorUid == existing().authorUid &&
        incoming().updatedAt == request.time &&
        isAdmin() && (
          // Action 1: Status / Schedule / Archive transition
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'startAt', 'endAt', 'updatedAt']) ||
          // Action 2: Reorder slide
          incoming().diff(existing()).affectedKeys().hasOnly(['order', 'updatedAt']) ||
          // Action 3: Full content / image / schedule edit by Admin
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'subtitle',
            'category',
            'buttonText',
            'targetUrl',
            'imageUrl',
            'storagePath',
            'alt',
            'order',
            'status',
            'startAt',
            'endAt',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() &&
        isValidId(slideId) &&
        isAdmin();
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (
        request.auth.uid == adminId || isAdmin()
      );

      allow list: if isBootstrappedAdmin() && existing().role == 'admin';

      allow create: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();

      allow update: if false;

      allow delete: if isSignedIn() &&
        isValidId(adminId) &&
        isBootstrappedAdmin();
    }
  }
}
