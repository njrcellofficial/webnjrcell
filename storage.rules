rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'njrcell.official@gmail.com' ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Public read access for slideshow banner images; write/delete restricted to verified admins
    match /slides/{slideFile} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
